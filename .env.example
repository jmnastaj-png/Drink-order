# Environment example for Drink-order

# Base URL exposed to the browser (used for QR codes)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database (Postgres) - replace with your managed Postgres URL
DATABASE_URL=postgresql://user:password@localhost:5432/drink_order_db

# NextAuth (magic link) settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_long_random_value

# SMTP settings for NextAuth Email provider (magic link)
SMTP_SERVER=smtp://user:pass@smtp.example.com:587
SMTP_FROM="Drink Order" <noreply@example.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin email for initial seeding (optional)
ADMIN_EMAIL=admin@example.com
